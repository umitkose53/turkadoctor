# Neon Postgres (production)
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Site
NEXT_PUBLIC_SITE_URL="https://turkadoctor.com"
NEXT_PUBLIC_SITE_NAME="TurkaDoctor"

# SEO kontenjan flag — Bakanlık tebliği gelirse "false" yap, tüm "en iyi"
# başlıklar nötr şablona döner (deploy gerektirir; ENV ile değiştirilebilir).
NEXT_PUBLIC_SEO_AGGRESSIVE_TITLES="true"

# Google Places (yorum widget)
GOOGLE_PLACES_API_KEY=""

# Resend (yorum doğrulama e-postaları — sonra)
RESEND_API_KEY=""
